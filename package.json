{
  "name": "column-flow-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=column-flow-react-vite",
    "publish:dry-run": "npm publish --workspace column-flow --dry-run",
    "publish:npm": "npm publish --workspace column-flow --access public",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "version:bump": "npm version --workspace column-flow",
    "version:major": "npm version major --workspace column-flow",
    "version:minor": "npm version minor --workspace column-flow",
    "version:patch": "npm version patch --workspace column-flow"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
