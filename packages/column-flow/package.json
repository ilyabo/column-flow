{
  "name": "column-flow",
  "version": "0.0.0",
  "description": "A React component for supply chain visualizations and column-organized node-link graphs.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/column-flow.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "tsc && cp src/column-flow.css dist/column-flow.css",
    "dev": "tsc -w",
    "prepublishOnly": "pnpm run build",
    "publish:dry-run": "npm publish --dry-run",
    "publish:npm": "npm publish --access public",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "version:bump": "npm version",
    "version:major": "npm version major",
    "version:minor": "npm version minor",
    "version:patch": "npm version patch"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
